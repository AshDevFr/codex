# Frontend development Dockerfile
FROM node:22-alpine

WORKDIR /app

# Copy package files first for better caching
COPY package.json package-lock.json ./

# Install dependencies from the lockfile. This used to delete the lockfile to
# work around npm/cli#4828 (optional platform deps missing on musl), but that
# bug is fixed: the lockfile records every platform's optional dependencies.
# A fresh `npm install` resolution is also what crashes npm 10 against some
# registry states ("Cannot read properties of null (reading 'edgesOut')"),
# so the lockfile install is both reproducible and the reliable option.
RUN npm ci

# Copy the rest of the source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Run Vite dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
